# AgentHub environment template. Copy to `.env` for local development.
# NEVER commit a real `.env`. Never put production secrets in source control.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=true
# Generate one for shared/staging use; local settings provide an insecure default.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgres://agenthub:agenthub@localhost:5432/agenthub

# --- Redis (cache + Celery broker/result backend) ---
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND default to REDIS_URL if unset.

# --- Object storage (S3/MinIO) — used by ingestion from Sprint 5 ---
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=agenthub
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
# Object store credentials are provided via the platform secret manager, not here.

# --- Confluence Data Center (P7.4, disabled by default) ---
# Deployment-owned policy JSON; never accept CIDRs from a tenant/source/request.
# CONFLUENCE_NETWORK_POLICIES={"corp-confluence":["10.20.30.0/24"]}
# A profile secret_ref `secret:kb-reader` resolves from injected CONFLUENCE_SECRET_KB_READER.

# Opt-in governed live model/embedding providers. Keep these empty for deterministic local/CI
# behavior. Credentials are deployment secrets and must never be committed.
RUNTIME_MODEL_PROVIDER=
MODEL_SECRET_GEMINI=
RUNTIME_EMBEDDING_PROVIDER=
EMBEDDING_SECRET_GEMINI=
# Register an approved immutable ModelProfile first; use its public UUID, never an endpoint or secret.
AI_AUTHORING_MODEL_PROFILE_ID=
AI_AUTHORING_PROVIDER=apps.orchestration.authoring.OpenAICompatibleAuthoringProvider
# Do not put the real PAT in this file.

# --- Production-only (do not set locally) ---
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
