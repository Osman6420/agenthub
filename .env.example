# AgentHub environment template. Copy to `.env` for local development.
# NEVER commit a real `.env`. Never put production secrets in source control.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=true
# Generate one for shared/staging use; local settings provide an insecure default.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgres://agenthub:agenthub@localhost:5432/agenthub

# --- Redis (cache + Celery broker/result backend) ---
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND default to REDIS_URL if unset.

# --- Object storage (S3/MinIO) — used by ingestion from Sprint 5 ---
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=agenthub
OBJECT_STORE_REGION=us-east-1
# Object store credentials are provided via the platform secret manager, not here.

# --- Production-only (do not set locally) ---
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
