{
  "name": "agenthub-workflow-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React Flow visual workflow builder for the AgentHub operator console.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test --config=playwright.config.ts"
  },
  "dependencies": {
    "@xyflow/react": "12.3.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.5.0",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "25.0.1",
    "typescript": "5.6.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
