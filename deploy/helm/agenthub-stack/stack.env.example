# Copy to stack.env, chmod 600, replace every REPLACE value, and never commit it.
NAMESPACE=agenthub-demo

# These hosts must match the Helm release/fullname. Defaults assume release name agenthub-stack.
STACK_POSTGRES_HOST=agenthub-stack-postgresql
STACK_REDIS_HOST=agenthub-stack-redis

STACK_POSTGRES_ADMIN_USER=postgres
STACK_POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_VALUE
STACK_POSTGRES_DATABASE=agenthub
STACK_POSTGRES_MIGRATION_USER=agenthub_migrator
STACK_POSTGRES_MIGRATION_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_VALUE
STACK_POSTGRES_APPLICATION_USER=agenthub_app
STACK_POSTGRES_APPLICATION_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_VALUE
STACK_REDIS_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_VALUE

# MinIO administration is separate from AgentHub's bucket-scoped S3 client identity.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_VALUE
AWS_ACCESS_KEY_ID=agenthubminio
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_URL_SAFE_RANDOM_VALUE

DJANGO_SECRET_KEY=REPLACE
METRICS_BEARER_TOKEN=REPLACE
BOOTSTRAP_ADMIN_PASSWORD=REPLACE
MODEL_API_KEY=REPLACE
EMBEDDING_API_KEY=REPLACE
