# Copy to openshift.env, chmod 600, fill every REQUIRED value, then run:
#   ./deploy/openshift/install/install.sh deploy/openshift/install/openshift.env

# REQUIRED: target and immutable images. Image references must contain @sha256:<64 hex>.
NAMESPACE=agenthub-demo
CREATE_NAMESPACE=false
RELEASE_ID=release-2026-08-03
APPLICATION_IMAGE=registry.example.com/team/agenthub@sha256:REPLACE_WITH_64_HEX_DIGEST
STATIC_IMAGE=registry.example.com/team/agenthub-static@sha256:REPLACE_WITH_64_HEX_DIGEST
ROUTE_HOST=agenthub-demo.apps.cluster.example.com

# REQUIRED: approved managed services. PostgreSQL must include pgvector.
# Runtime must be a non-owner, non-superuser, NOBYPASSRLS application role.
DATABASE_URL=postgres://agenthub_app:REPLACE@postgres.example.com:5432/agenthub
# Migration uses a separate reviewed schema-owner/migration role.
MIGRATION_DATABASE_URL=postgres://agenthub_migrator:REPLACE@postgres.example.com:5432/agenthub
REDIS_URL=rediss://:REPLACE@redis.example.com:6380/0
OBJECT_STORE_ENDPOINT=https://s3.example.com
OBJECT_STORE_BUCKET=agenthub-demo
OBJECT_STORE_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE

# REQUIRED: application secrets. Generate with: openssl rand -base64 48
DJANGO_SECRET_KEY=REPLACE
METRICS_BEARER_TOKEN=REPLACE
BOOTSTRAP_ADMIN_PASSWORD=REPLACE
PLATFORM_ACTOR=platform-recovery

# REQUIRED: generic OpenAI-compatible chat endpoint; do not include https:// in HOST.
MODEL_API_KEY=REPLACE
MODEL_LOGICAL_ID=primary-chat
MODEL_REVISION=1
MODEL_HOST=llm-gateway.example.com
MODEL_PORT=443
MODEL_PATH=/v1/chat/completions
MODEL_NAME=REPLACE_WITH_MODEL_NAME

# REQUIRED: generic OpenAI-compatible embeddings endpoint and exact vector dimension.
EMBEDDING_API_KEY=REPLACE
EMBEDDING_LOGICAL_ID=primary-embedding
EMBEDDING_REVISION=1
EMBEDDING_HOST=embedding-gateway.example.com
EMBEDDING_PORT=443
EMBEDDING_PATH=/v1/embeddings
EMBEDDING_NAME=REPLACE_WITH_EMBEDDING_MODEL_NAME
EMBEDDING_DIMENSIONS=1024
EMBEDDING_INDEX_TYPE=vector

# Optional external-consumer demo. Set false to install only AgentHub.
INSTALL_EXTERNAL_DEMO=true
DEMO_IMAGE=registry.example.com/team/agenthub-external-demo@sha256:REPLACE_WITH_64_HEX_DIGEST
DEMO_ROUTE_HOST=agenthub-external-demo.apps.cluster.example.com
