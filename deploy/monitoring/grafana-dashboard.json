{
  "title": "AgentHub Sprint 7 Operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "REST and MCP request rate",
      "targets": [
        {"expr": "sum by (transport, operation, status) (rate(agenthub_gateway_requests_total[5m]))"}
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 request latency",
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, transport, operation) (rate(agenthub_gateway_request_duration_seconds_bucket[5m])))"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ingestion outcomes",
      "targets": [
        {"expr": "sum by (status) (rate(agenthub_ingestion_runs_total[15m]))"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Release lifecycle decisions",
      "targets": [
        {"expr": "sum by (action, outcome) (rate(agenthub_release_lifecycle_total[15m]))"}
      ]
    }
  ]
}
